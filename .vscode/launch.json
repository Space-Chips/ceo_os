{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter iOS (iPhone 16e)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "deviceId": "iPhone 16e",
      "preLaunchTask": "Boot iPhone 16e Simulator",
      "toolArgs": [
        "--dart-define-from-file=.vscode/supabase.local.json"
      ]
    },
    {
      "name": "Flutter iOS (iPhone 16e, prompt)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "deviceId": "iPhone 16e",
      "preLaunchTask": "Boot iPhone 16e Simulator",
      "toolArgs": [
        "--dart-define=SUPABASE_URL=${input:supabaseUrl}",
        "--dart-define=SUPABASE_ANON_KEY=${input:supabaseAnonKey}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "supabaseUrl",
      "type": "promptString",
      "description": "Supabase URL (https://<project>.supabase.co)"
    },
    {
      "id": "supabaseAnonKey",
      "type": "promptString",
      "description": "Supabase anon key",
      "password": true
    }
  ]
}
