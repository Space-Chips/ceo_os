+class _AccountStatusStrip extends StatelessWidget {
+  final PremiumRuntime runtime;
+  final bool isFr;
+
+  const _AccountStatusStrip({required this.runtime, required this.isFr});
+
+  @override
+  Widget build(BuildContext context) {
+    final tags = <String>[
+      if (runtime.resolved.badgeCode == 'early_user')
+        isFr ? 'Badge Early Access' : 'Early Access badge',
+      if (runtime.resolved.themeBundleGranted)
+        isFr ? 'Tous les thèmes conservés' : 'All themes retained',
+      if (runtime.resolved.discountEligible)
+        runtime.resolved.discountPercent != null
+            ? (isFr
+                  ? 'Réduction ${runtime.resolved.discountPercent}%'
+                  : '${runtime.resolved.discountPercent}% pricing')
+            : (isFr ? 'Tarif early access' : 'Early access pricing'),
+    ];
+
+    return Wrap(
+      spacing: 8,
+      runSpacing: 8,
+      children: tags
+          .map(
+            (tag) => Container(
+              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 7),
+              decoration: BoxDecoration(
+                color: AppColors.accentSurfaceSoft.withValues(alpha: 0.78),
+                borderRadius: BorderRadius.circular(999),
+                border: Border.all(
+                  color: AppColors.selectionOutline.withValues(alpha: 0.4),
+                  width: 0.8,
+                ),
+              ),
+              child: Text(
+                tag,
+                style: AppTypography.caption1.copyWith(
+                  color: AppColors.accentText.withValues(alpha: 0.94),
+                  fontWeight: FontWeight.w600,
+                ),
+              ),
+            ),
+          )
+          .toList(),
+    );
+  }
+}
