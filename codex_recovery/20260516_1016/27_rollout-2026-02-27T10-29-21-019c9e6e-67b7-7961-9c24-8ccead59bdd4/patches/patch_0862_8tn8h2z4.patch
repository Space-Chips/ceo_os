+  String _footnoteText() {
+    if (runtime.resolved.discountEligible) {
+      final percent = runtime.resolved.discountPercent;
+      if (_isFr) {
+        return percent != null
+            ? 'Ton compte conserve une offre early access de $percent% quand l’abonnement ouvrira.'
+            : 'Ton compte conserve une offre early access quand l’abonnement ouvrira.';
+      }
+      return percent != null
+          ? 'Your account keeps an early access discount of $percent% when subscriptions open.'
+          : 'Your account keeps early access pricing when subscriptions open.';
+    }
+
+    if (_isFr) {
+      return runtime.config.paywallEnabled
+          ? 'Le paiement sera activé dans une prochaine étape. Cette interface prépare déjà le flux Premium.'
+          : 'Premium est déjà structuré dans l’app. Le paiement sera activé après la période de lancement.';
+    }
+    return runtime.config.paywallEnabled
+        ? 'Billing will be connected in a follow-up step. This paywall already prepares the Premium flow.'
+        : 'Premium is already structured in the app. Billing will go live after the launch period.';
