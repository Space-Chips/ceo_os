+Future<void> showPremiumGateDialog(
+  BuildContext context,
+  PremiumCheckResult result,
+) async {
+  if (result.allowed) return;
+
+  final languageCode = context.read<LanguageProvider>().languageCode;
+  final runtime = await PremiumRepository().getRuntime();
+  if (!context.mounted) return;
+
+  await showCupertinoModalPopup<void>(
+    context: context,
+    barrierColor: AppColors.overlayScrim.withValues(alpha: 0.76),
+    builder: (sheetContext) => _PremiumPaywallSheet(
+      result: result,
+      runtime: runtime,
+      languageCode: languageCode,
+    ),
+  );
+}
