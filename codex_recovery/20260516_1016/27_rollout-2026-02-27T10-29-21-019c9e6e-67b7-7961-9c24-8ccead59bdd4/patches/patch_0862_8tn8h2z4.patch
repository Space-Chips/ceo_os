+List<String> _benefitsForReason(
+  String? reason,
+  PremiumRuntime runtime,
+  bool isFr,
+) {
+  switch (reason) {
+    case 'tasks':
+      return [
+        isFr ? 'Tâches actives illimitées' : 'Unlimited active tasks',
+        isFr
+            ? 'Organisation complète sans forcer d’archivage'
+            : 'Full planning without forced cleanup',
+        isFr
+            ? 'Même structure de travail sur toute la semaine'
+            : 'A stable working system across the full week',
+      ];
+    case 'habits':
+      return [
+        isFr ? 'Habitudes actives illimitées' : 'Unlimited active habits',
+        isFr
+            ? 'Systèmes multi-objectifs sans arbitrage forcé'
+            : 'Multi-goal habit systems without artificial tradeoffs',
+        isFr
+            ? 'Suivi plus fidèle de tes protocoles quotidiens'
+            : 'More faithful tracking of your daily protocols',
+      ];
+    case 'notes':
+      return [
+        isFr ? 'Notes illimitées' : 'Unlimited notes',
+        isFr
+            ? 'Capture continue sans nettoyage imposé'
+            : 'Continuous capture without forced cleanup',
+        isFr
+            ? 'Un système de pensée plus complet dans le temps'
+            : 'A more complete long-term thinking system',
+      ];
+    case 'themes':
+      return [
+        isFr
+            ? 'Accès permanent aux thèmes premium'
+            : 'Permanent access to Premium themes',
+        isFr
+            ? 'Modern Desert et Royal Violet'
+            : 'Modern Desert and Royal Violet',
+        if (runtime.resolved.themeBundleGranted)
+          isFr
+              ? 'Ton compte conserve déjà le bundle de thèmes'
+              : 'Your account already keeps the theme bundle',
+      ];
+    case 'focus_daily':
+    case 'focus_duration':
+      return [
+        isFr ? 'Sessions Focus illimitées' : 'Unlimited Focus sessions',
+        isFr ? 'Durées longues de session' : 'Extended session durations',
+        isFr
+            ? 'Une discipline de travail sans plafond artificiel'
+            : 'Deep work without artificial session ceilings',
+      ];
+    case 'ceo_weekly':
+    case 'ceo_duration':
+      return [
+        isFr ? 'CEO Mode illimité' : 'Unlimited CEO Mode',
+        isFr ? 'Durées longues de session' : 'Extended session durations',
+        isFr
+            ? 'Protection totale pour les sessions critiques'
+            : 'Full-strength protection for critical sessions',
+      ];
+    case 'reports':
+      return [
+        isFr ? 'Rapports avancés' : 'Advanced reports',
+        isFr
+            ? 'Lecture plus profonde de ta progression'
+            : 'Deeper visibility into your progress',
+        isFr
+            ? 'Analyse plus utile pour ajuster ton système'
+            : 'More actionable feedback for refining your system',
+      ];
+    case 'calendar_advanced':
+      return [
+        isFr ? 'Calendrier avancé' : 'Advanced calendar',
+        isFr ? 'Types d’événements premium' : 'Premium event types',
+        isFr
+            ? 'Planification plus fine au-delà du mode anniversaire'
+            : 'Finer planning beyond birthday mode',
+      ];
+    default:
+      return [
+        isFr
+            ? 'Déverrouillage complet des fonctions Premium'
+            : 'Full access to Premium features',
+        isFr
+            ? 'Focus et CEO Mode étendus'
+            : 'Extended Focus and CEO Mode',
+        isFr
+            ? 'Reports, calendar avancé et thèmes premium'
+            : 'Reports, advanced calendar, and Premium themes',
+      ];
+  }
+}
