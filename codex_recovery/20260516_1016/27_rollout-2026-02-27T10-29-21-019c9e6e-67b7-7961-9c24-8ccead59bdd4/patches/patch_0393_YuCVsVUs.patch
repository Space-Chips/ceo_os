+class _BrushedTexturePainter extends CustomPainter {
+  final double lineAlpha;
+
+  const _BrushedTexturePainter({required this.lineAlpha});
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final light = Paint()
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 0.7
+      ..color = AppColors.glassHighlightSoft.withValues(alpha: lineAlpha);
+    final dark = Paint()
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 0.6
+      ..color = AppColors.glassShadowSoft.withValues(alpha: lineAlpha * 0.9);
+
+    final lines = math.max(12, (size.height / 18).floor());
+    for (var i = 0; i < lines; i++) {
+      final y = i * size.height / lines;
+      final offset = (i % 4) * 2.2;
+      final p = Path()
+        ..moveTo(0, y + offset)
+        ..lineTo(size.width, y - offset);
+      canvas.drawPath(p, i.isEven ? light : dark);
+    }
+  }
+
+  @override
+  bool shouldRepaint(covariant _BrushedTexturePainter oldDelegate) {
+    return oldDelegate.lineAlpha != lineAlpha;
+  }
