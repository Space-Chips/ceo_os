+              ),
+              alignment: Alignment.center,
+              child: Icon(
+                option.icon,
+                size: 18,
+                color: enabled ? const Color(0xFF4C7DFF) : AppColors.tertiaryLabel,
+              ),
+            ),
+            const SizedBox(width: 12),
+            Expanded(
+              child: Text(
+                option.title,
