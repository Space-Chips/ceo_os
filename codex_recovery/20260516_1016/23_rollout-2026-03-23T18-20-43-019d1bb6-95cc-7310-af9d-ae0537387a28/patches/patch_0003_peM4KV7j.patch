+    }
+    if (selected == null) {
+      return widget.isFr ? 'Offres indisponibles' : 'Offers unavailable';
+    }
+    return widget.isFr
+        ? 'Continuer - ${selected.priceLabel}'
+        : 'Continue - ${selected.priceLabel}';
+  }
+
+  String _disclosureText(BillingPackageOption? selected) {
+    if (selected == null) {
+      return widget.isFr
+          ? 'Les achats sont gérés par Apple. Si aucune offre n’apparaît, le paiement reste désactivé jusqu’à configuration complète des produits.'
+          : 'Purchases are handled by Apple. If no offer appears, purchasing stays disabled until products are fully configured.';
+    }
+
+    final renewal = selected.renewalLabel ??
+        (widget.isFr ? 'Abonnement auto-renouvelable' : 'Auto-renewable subscription');
+    final intro = selected.introOfferLabel;
+    final parts = <String>[
+      widget.isFr
+          ? '${selected.title} : ${selected.priceLabel} pour ${selected.durationLabel.toLowerCase()}.'
+          : '${selected.title}: ${selected.priceLabel} for ${selected.durationLabel.toLowerCase()}.',
+      renewal,
+      widget.isFr
+          ? 'L’abonnement peut être géré et annulé dans les réglages Apple ID après achat.'
+          : 'Subscriptions can be managed and cancelled in Apple ID settings after purchase.',
+    ];
+    if (intro != null) {
