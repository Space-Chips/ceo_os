+String _footnoteText(PremiumRuntime runtime, bool isFr) {
+  if (runtime.resolved.discountEligible) {
+    final percent = runtime.resolved.discountPercent;
+    if (isFr) {
+      return percent != null
+          ? 'Ton compte conserve une offre early access de $percent% lorsqu’un abonnement éligible est disponible.'
+          : 'Ton compte conserve une offre early access lorsqu’un abonnement éligible est disponible.';
+    }
+    return percent != null
+        ? 'Your account keeps an early access discount of $percent% when an eligible subscription is available.'
+        : 'Your account keeps early access pricing when an eligible subscription is available.';
+  }
+
+  return isFr
+      ? 'Le paiement Premium est traité par Apple. L’accès Premium est activé après confirmation du store et synchronisation du compte.'
+      : 'Premium billing is processed by Apple. Premium access is activated after store confirmation and account sync.';
+}
