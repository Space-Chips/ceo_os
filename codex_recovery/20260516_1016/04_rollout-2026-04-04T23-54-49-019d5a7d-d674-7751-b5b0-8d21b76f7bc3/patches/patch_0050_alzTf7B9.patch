+            packageManager.getApplicationLabel(appInfo)?.toString()?.trim().orEmpty()
+                .ifEmpty { packageName.substringAfterLast('.') }
+        } catch (_: Exception) {
+            packageName.substringAfterLast('.')
+        }
+    }
