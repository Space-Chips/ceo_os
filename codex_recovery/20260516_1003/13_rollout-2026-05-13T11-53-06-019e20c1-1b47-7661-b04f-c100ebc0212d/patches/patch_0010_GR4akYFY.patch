+/**
+ * Fullscreen, instant app-block overlay.
+ *
+ * Uses TYPE_ACCESSIBILITY_OVERLAY for speed + reliability (no Activity launch).
+ * Must be driven by an AccessibilityService instance.
+ */
+class AppBlockingOverlay(
+    private val service: AccessibilityService,
+    private val scope: CoroutineScope,
+) {
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private val windowManager = service.getSystemService(Context.WINDOW_SERVICE) as WindowManager
+    private val packageManager: PackageManager = service.packageManager
+
+    @Volatile
+    private var attached: Boolean = false
+
+    @Volatile
+    private var visibleForPackage: String? = null
+
+    private val appLabelCache = mutableMapOf<String, String>()
+
+    private val rootView: FrameLayout = FrameLayout(service).apply {
+        setBackgroundColor(Color.parseColor("#F00B0D11"))
+        isClickable = true
+        isFocusable = true
+        importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_YES
+    }
+
+    private val kickerView: TextView
+    private val titleView: TextView
+    private val subtitleView: TextView
+    private val primaryButton: TextView
+    private val secondaryButton: TextView
+
+    init {
+        val content = LinearLayout(service).apply {
+            orientation = LinearLayout.VERTICAL
+            layoutParams = FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT,
+            )
+            setPadding(dp(20), dp(28), dp(20), dp(20))
+        }
+
+        kickerView = TextView(service).apply {
+            setTextColor(Color.parseColor("#FFAA7C"))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 11f)
+            letterSpacing = 0.18f
+            typeface = Typeface.DEFAULT_BOLD
+            text = "BLOCKED"
+        }
+
+        titleView = TextView(service).apply {
+            setTextColor(Color.parseColor("#FFF5F7FA"))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 28f)
+            setLineSpacing(0f, 1.05f)
+            typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
+            text = "This app is blocked"
+        }
+
+        subtitleView = TextView(service).apply {
+            setTextColor(Color.parseColor("#C9D0D8E2"))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+            setLineSpacing(0f, 1.28f)
+            text = "WakeApp is preventing access right now."
+        }
+
+        val spacer = View(service).apply {
+            layoutParams = LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                0,
+                1f,
+            )
+        }
+
+        primaryButton = TextView(service).apply {
+            gravity = Gravity.CENTER
+            setTextColor(Color.parseColor("#FFF5F7FA"))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+            typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
+            setPadding(dp(18), dp(15), dp(18), dp(15))
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.RECTANGLE
+                cornerRadius = dp(18).toFloat()
+                setColor(Color.parseColor("#FF232A35"))
+                setStroke(dp(1), Color.parseColor("#33F5F7FA"))
+            }
+            text = "Return to Home"
+            setOnClickListener { service.performGlobalAction(AccessibilityService.GLOBAL_ACTION_HOME) }
+        }
+
+        secondaryButton = TextView(service).apply {
+            gravity = Gravity.CENTER
+            setTextColor(Color.parseColor("#D7DCE5"))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+            typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
+            setPadding(dp(18), dp(14), dp(18), dp(14))
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.RECTANGLE
+                cornerRadius = dp(18).toFloat()
+                setColor(Color.parseColor("#141B22"))
+                setStroke(dp(1), Color.parseColor("#22F5F7FA"))
+            }
+            text = "Open WakeApp"
+            setOnClickListener { openWakeApp() }
+        }
+
+        content.addView(kickerView)
+        content.addView(space(dp(10)))
+        content.addView(titleView)
+        content.addView(space(dp(10)))
+        content.addView(subtitleView)
+        content.addView(spacer)
+        content.addView(primaryButton, LinearLayout.LayoutParams(
+            ViewGroup.LayoutParams.MATCH_PARENT,
+            ViewGroup.LayoutParams.WRAP_CONTENT,
+        ))
+        content.addView(space(dp(12)))
+        content.addView(secondaryButton, LinearLayout.LayoutParams(
+            ViewGroup.LayoutParams.MATCH_PARENT,
+            ViewGroup.LayoutParams.WRAP_CONTENT,
+        ))
+
+        rootView.addView(content)
+    }
+
+    fun isVisible(): Boolean = visibleForPackage != null
+
+    fun show(decision: BlockDecision.BlockApp) {
+        val targetPackage = decision.packageName.trim()
+        if (targetPackage.isEmpty()) return
+        mainHandler.post {
+            ensureAttached()
+            visibleForPackage = targetPackage
+            updateTexts(targetPackage, decision.reason)
+            rootView.visibility = View.VISIBLE
+        }
+        resolveAppLabelAsync(targetPackage, decision.reason)
+    }
+
+    fun hide() {
+        mainHandler.post {
+            visibleForPackage = null
+            if (attached) {
+                rootView.visibility = View.GONE
+            }
+        }
+    }
+
+    fun hideIfShowingForOtherPackage(currentForegroundPackage: String?) {
+        val current = currentForegroundPackage?.trim().orEmpty()
+        val showingFor = visibleForPackage
+        if (showingFor != null && showingFor != current) {
+            hide()
+        }
+    }
+
+    private fun ensureAttached() {
+        if (attached) return
+        rootView.visibility = View.GONE
+        windowManager.addView(rootView, overlayLayoutParams())
+        attached = true
+    }
+
+    private fun overlayLayoutParams(): WindowManager.LayoutParams {
+        val type = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP_MR1) {
+            WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY
+        } else {
+            @Suppress("DEPRECATION")
+            WindowManager.LayoutParams.TYPE_PHONE
+        }
+        val flags = (
+            WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
+            )
+        return WindowManager.LayoutParams(
+            WindowManager.LayoutParams.MATCH_PARENT,
+            WindowManager.LayoutParams.MATCH_PARENT,
+            type,
+            flags,
+            android.graphics.PixelFormat.TRANSLUCENT,
+        ).apply {
+            gravity = Gravity.TOP or Gravity.START
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
+            }
+        }
+    }
+
+    private fun updateTexts(targetPackage: String, reason: String) {
+        val appName = appLabelCache[targetPackage] ?: targetPackage.substringAfterLast('.')
+        when (reason) {
+            "daily_limit" -> {
+                kickerView.text = "DAILY LIMIT"
+                titleView.text = "$appName is unavailable for now"
+                subtitleView.text = "You have reached today's allowed time for this app. WakeApp will unlock it again tomorrow."
+            }
+            "blackout" -> {
+                kickerView.text = "BLACKOUT MODE"
+                titleView.text = "$appName is blocked"
+                subtitleView.text = "This app stays locked while Blackout Mode is active so you can stay fully off distractions."
+            }
+            "focus" -> {
+                kickerView.text = "FOCUS MODE"
+                titleView.text = "$appName is blocked"
+                subtitleView.text = "This app is unavailable during your current Focus session."
+            }
+            "scheduled_pause" -> {
+                kickerView.text = "SCHEDULED PAUSE"
+                titleView.text = "$appName is blocked"
+                subtitleView.text = "This app is unavailable during the pause window you planned in WakeApp."
+            }
+            else -> {
+                kickerView.text = "BLOCKED"
+                titleView.text = "$appName is blocked"
+                subtitleView.text = "This app is on your blocked list in WakeApp. Open WakeApp to change the selection."
+            }
+        }
+    }
+
+    private fun resolveAppLabelAsync(targetPackage: String, reason: String) {
+        if (appLabelCache.containsKey(targetPackage)) return
+        scope.launch(Dispatchers.Default) {
+            val label = withContext(Dispatchers.Default) {
+                try {
+                    val appInfo = packageManager.getApplicationInfo(targetPackage, 0)
+                    packageManager.getApplicationLabel(appInfo)?.toString()?.trim().orEmpty()
+                } catch (_: Exception) {
+                    ""
+                }
+            }.ifEmpty { targetPackage.substringAfterLast('.') }
+
+            appLabelCache[targetPackage] = label
+            mainHandler.post {
+                if (visibleForPackage == targetPackage) {
+                    updateTexts(targetPackage, reason)
+                }
+            }
+        }
+    }
+
+    private fun openWakeApp() {
+        val launchIntent = packageManager.getLaunchIntentForPackage(service.packageName)?.apply {
+            addFlags(
+                Intent.FLAG_ACTIVITY_NEW_TASK or
+                    Intent.FLAG_ACTIVITY_CLEAR_TOP or
+                    Intent.FLAG_ACTIVITY_NO_ANIMATION,
+            )
+        } ?: return
+        try {
+            service.startActivity(launchIntent)
+        } catch (_: Exception) {
+        }
+    }
+
+    private fun space(heightPx: Int): View {
+        return View(service).apply {
+            layoutParams = LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                heightPx,
+            )
+        }
+    }
+
+    private fun dp(value: Int): Int {
+        return (value * service.resources.displayMetrics.density).toInt()
+    }
+}
