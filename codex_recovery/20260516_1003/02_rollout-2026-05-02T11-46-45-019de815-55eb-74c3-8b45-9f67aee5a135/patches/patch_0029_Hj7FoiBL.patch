+package com.wakeapp.ceoos
+
+import android.app.Activity
+import android.appwidget.AppWidgetManager
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.widget.Button
+
+class CeoHomeWidgetConfigureActivity : Activity() {
+
+  private var appWidgetId: Int = AppWidgetManager.INVALID_APPWIDGET_ID
+
+  override fun onCreate(savedInstanceState: Bundle?) {
+    super.onCreate(savedInstanceState)
+    setResult(RESULT_CANCELED)
+    setContentView(R.layout.ceo_home_widget_configure)
+
+    appWidgetId =
+        intent?.extras?.getInt(AppWidgetManager.EXTRA_APPWIDGET_ID, AppWidgetManager.INVALID_APPWIDGET_ID)
+            ?: AppWidgetManager.INVALID_APPWIDGET_ID
+
+    if (appWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) {
+      finish()
+      return
+    }
+
+    findViewById<Button>(R.id.btn_mode_todo).setOnClickListener {
+      finishWithMode(CeoHomeWidgetProvider.MODE_TODO)
+    }
+    findViewById<Button>(R.id.btn_mode_dashboard).setOnClickListener {
+      finishWithMode(CeoHomeWidgetProvider.MODE_DASHBOARD)
+    }
+    findViewById<Button>(R.id.btn_mode_habits).setOnClickListener {
+      finishWithMode(CeoHomeWidgetProvider.MODE_HABITS)
+    }
+  }
+
+  private fun finishWithMode(mode: String) {
+    val prefs = getSharedPreferences(CeoHomeWidgetProvider.PREFS, Context.MODE_PRIVATE)
+    prefs.edit().putString("${CeoHomeWidgetProvider.PREF_MODE_PREFIX}${appWidgetId}", mode).apply()
+
+    val update = Intent(this, CeoHomeWidgetProvider::class.java)
+    update.action = AppWidgetManager.ACTION_APPWIDGET_UPDATE
+    update.putExtra(AppWidgetManager.EXTRA_APPWIDGET_IDS, intArrayOf(appWidgetId))
+    sendBroadcast(update)
+
+    val resultValue = Intent()
+    resultValue.putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, appWidgetId)
+    setResult(RESULT_OK, resultValue)
+    finish()
+  }
+}
