+import AppIntents
+import SwiftUI
+import WidgetKit
+
+private let appGroupId = "group.com.wakeapp.ceoos"
+
+private let keyDefaultMode = "ceo_widget_default_mode"
+
+private let keyTodoSmall = "ceo_widget_todo_small"
+private let keyTodoLarge = "ceo_widget_todo_large"
+private let keyDashboardSmall = "ceo_widget_dashboard_small"
+private let keyDashboardLarge = "ceo_widget_dashboard_large"
+private let keyHabitsSmall = "ceo_widget_habits_small"
+private let keyHabitsLarge = "ceo_widget_habits_large"
+
+enum CeoWidgetMode: String, AppEnum {
+  case auto
+  case todo
+  case dashboard
+  case habits
+
+  static var typeDisplayRepresentation: TypeDisplayRepresentation = "Widget View"
+
+  static var caseDisplayRepresentations: [CeoWidgetMode: DisplayRepresentation] = [
+    .auto: "Auto",
+    .todo: "To‑Do",
+    .dashboard: "Dashboard",
+    .habits: "Habits",
+  ]
+}
+
+struct CeoWidgetIntent: AppIntent, WidgetConfigurationIntent {
+  static var title: LocalizedStringResource = "Widget"
+  static var description = IntentDescription("Choose what the widget shows.")
+
+  @Parameter(title: "View")
+  var mode: CeoWidgetMode
+
+  init() {
+    self.mode = .auto
+  }
+}
+
+struct CeoWidgetEntry: TimelineEntry {
+  let date: Date
+  let mode: CeoWidgetMode
+}
+
+struct CeoWidgetProvider: AppIntentTimelineProvider {
+  func placeholder(in context: Context) -> CeoWidgetEntry {
+    CeoWidgetEntry(date: Date(), mode: .auto)
+  }
+
+  func snapshot(for configuration: CeoWidgetIntent, in context: Context) async -> CeoWidgetEntry {
+    CeoWidgetEntry(date: Date(), mode: configuration.mode)
+  }
+
+  func timeline(for configuration: CeoWidgetIntent, in context: Context) async -> Timeline<CeoWidgetEntry> {
+    let entry = CeoWidgetEntry(date: Date(), mode: configuration.mode)
+    return Timeline(entries: [entry], policy: .after(Date().addingTimeInterval(60)))
+  }
+}
+
+struct CeoHomeWidget: Widget {
+  let kind: String = "com.wakeapp.ceoos.widget"
+
+  var body: some WidgetConfiguration {
+    AppIntentConfiguration(kind: kind, intent: CeoWidgetIntent.self, provider: CeoWidgetProvider()) { entry in
+      CeoHomeWidgetView(entry: entry)
+    }
+    .configurationDisplayName("WakeApp")
+    .description("To‑do, dashboard, or habits — right on your Home Screen.")
+    .supportedFamilies([.systemSmall, .systemMedium, .systemLarge])
+  }
+}
+
+struct CeoHomeWidgetView: View {
+  var entry: CeoWidgetProvider.Entry
+
+  @Environment(\.widgetFamily) private var family
+
+  var body: some View {
+    let resolvedMode = resolveMode(entry.mode)
+    let large = family != .systemSmall
+    let imageKey = imageKeyFor(resolvedMode, large: large)
+    let path = sharedDefaults().string(forKey: imageKey)
+
+    Group {
+      if let path, let image = UIImage(contentsOfFile: path) {
+        Image(uiImage: image)
+          .resizable()
+          .scaledToFill()
+      } else {
+        ZStack {
+          Color.black.opacity(0.6)
+          VStack(spacing: 10) {
+            Text("WakeApp")
+              .font(.headline)
+              .foregroundStyle(.white)
+            Text("Open the app to generate widget previews.")
+              .font(.caption)
+              .foregroundStyle(.white.opacity(0.7))
+              .multilineTextAlignment(.center)
+              .padding(.horizontal, 10)
+          }
+        }
+      }
+    }
+    .containerBackground(.fill.tertiary, for: .widget)
+    .widgetURL(URL(string: routeUrlFor(resolvedMode)))
+    .clipped()
+  }
+
+  private func resolveMode(_ mode: CeoWidgetMode) -> CeoWidgetMode {
+    if mode != .auto { return mode }
+    let raw = sharedDefaults().string(forKey: keyDefaultMode) ?? "dashboard"
+    switch raw {
+    case "todo": return .todo
+    case "habits": return .habits
+    default: return .dashboard
+    }
+  }
+
+  private func imageKeyFor(_ mode: CeoWidgetMode, large: Bool) -> String {
+    switch mode {
+    case .todo: return large ? keyTodoLarge : keyTodoSmall
+    case .habits: return large ? keyHabitsLarge : keyHabitsSmall
+    default: return large ? keyDashboardLarge : keyDashboardSmall
+    }
+  }
+
+  private func routeUrlFor(_ mode: CeoWidgetMode) -> String {
+    switch mode {
+    case .todo: return "ceoos:///tasks"
+    case .habits: return "ceoos:///habits"
+    default: return "ceoos:///home"
+    }
+  }
+
+  private func sharedDefaults() -> UserDefaults {
+    UserDefaults(suiteName: appGroupId) ?? .standard
+  }
+}
+
