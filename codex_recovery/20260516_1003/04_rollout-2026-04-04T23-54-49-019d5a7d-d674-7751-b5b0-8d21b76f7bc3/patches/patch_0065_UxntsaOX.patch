+package com.wakeapp.ceoos
+
+import android.app.admin.DevicePolicyManager
+import android.content.ComponentName
+import android.content.Context
+import android.os.Build
+import android.util.Log
+import org.json.JSONArray
+
+object HardAppBlockManager {
+    private const val prefsName = "FlutterSharedPreferences"
+    private const val suspendedPackagesKey = "hard_block_suspended_packages"
+
+    private fun prefs(context: Context) =
+        context.getSharedPreferences(prefsName, Context.MODE_PRIVATE)
+
+    private fun adminComponent(context: Context): ComponentName {
+        return ComponentName(context, WakeDeviceAdminReceiver::class.java)
+    }
+
+    private fun devicePolicyManager(context: Context): DevicePolicyManager? {
+        return context.getSystemService(DevicePolicyManager::class.java)
+    }
+
+    private fun persistedSuspendedPackages(context: Context): Set<String> {
+        val raw = prefs(context).getString(suspendedPackagesKey, null).orEmpty()
+        if (raw.isEmpty()) return emptySet()
+        return try {
+            val array = JSONArray(raw)
+            buildSet {
+                for (index in 0 until array.length()) {
+                    val value = array.optString(index).trim()
+                    if (value.isNotEmpty()) add(value)
+                }
+            }
+        } catch (_: Exception) {
+            emptySet()
+        }
+    }
+
+    private fun persistSuspendedPackages(context: Context, packages: Set<String>) {
+        val payload = JSONArray()
+        packages.sorted().forEach { payload.put(it) }
+        prefs(context).edit().putString(suspendedPackagesKey, payload.toString()).apply()
+    }
+
+    fun status(context: Context): String {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) return "unsupported"
+        val dpm = devicePolicyManager(context) ?: return "unsupported"
+        return when {
+            dpm.isDeviceOwnerApp(context.packageName) -> "device_owner"
+            dpm.isProfileOwnerApp(context.packageName) -> "profile_owner"
+            dpm.isAdminActive(adminComponent(context)) -> "device_admin_only"
+            else -> "inactive"
+        }
+    }
+
+    fun canSuspendPackages(context: Context): Boolean {
+        val currentStatus = status(context)
+        return currentStatus == "device_owner" || currentStatus == "profile_owner"
+    }
+
+    fun syncBlockedPackages(context: Context, blockedPackages: Set<String>) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) return
+
+        val dpm = devicePolicyManager(context) ?: return
+        val admin = adminComponent(context)
+        val previous = persistedSuspendedPackages(context)
+
+        if (!canSuspendPackages(context)) {
+            if (previous.isNotEmpty()) {
+                try {
+                    dpm.setPackagesSuspended(admin, previous.toTypedArray(), false)
+                } catch (error: Exception) {
+                    Log.w("HardAppBlockManager", "Could not unsuspend packages after capability loss", error)
+                }
+            }
+            persistSuspendedPackages(context, emptySet())
+            return
+        }
+
+        val target = blockedPackages
+            .map { it.trim() }
+            .filter { it.isNotEmpty() && it != context.packageName }
+            .toSet()
+
+        val toSuspend = target - previous
+        val toUnsuspend = previous - target
+
+        if (toSuspend.isNotEmpty()) {
+            try {
+                dpm.setPackagesSuspended(admin, toSuspend.toTypedArray(), true)
+            } catch (error: Exception) {
+                Log.e("HardAppBlockManager", "Could not suspend blocked packages", error)
+            }
+        }
+
+        if (toUnsuspend.isNotEmpty()) {
+            try {
+                dpm.setPackagesSuspended(admin, toUnsuspend.toTypedArray(), false)
+            } catch (error: Exception) {
+                Log.e("HardAppBlockManager", "Could not unsuspend packages", error)
+            }
+        }
+
+        persistSuspendedPackages(context, target)
+    }
+}
