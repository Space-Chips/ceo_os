     private fun isSystemApp(applicationInfo: ApplicationInfo): Boolean {
         val flags = applicationInfo.flags
         return (flags and ApplicationInfo.FLAG_SYSTEM) != 0 ||
             (flags and ApplicationInfo.FLAG_UPDATED_SYSTEM_APP) != 0
     }
