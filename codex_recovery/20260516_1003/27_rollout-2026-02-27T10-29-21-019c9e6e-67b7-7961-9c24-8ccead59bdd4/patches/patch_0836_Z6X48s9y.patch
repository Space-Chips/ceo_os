+    private fun detectVisibleDomainFromEvent(event: AccessibilityEvent?): String? {
+        if (event == null) return null
+
+        val priorityCandidates = mutableListOf<String>()
+        val fallbackCandidates = mutableListOf<String>()
+
+        fun addCandidate(raw: CharSequence?, prioritized: Boolean = false) {
+            val value = raw?.toString()?.trim()
+            if (value.isNullOrEmpty()) return
+            if (prioritized) {
+                priorityCandidates.add(value)
+            } else {
+                fallbackCandidates.add(value)
+            }
+        }
+
+        val source = event.source
+        val sourceViewId = source?.viewIdResourceName?.lowercase(Locale.US).orEmpty()
+        val sourcePrioritized = prioritizedViewIdHints.any { sourceViewId.contains(it) }
+        addCandidate(source?.text, prioritized = sourcePrioritized)
+        addCandidate(source?.contentDescription, prioritized = sourcePrioritized)
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            addCandidate(source?.hintText, prioritized = sourcePrioritized)
+        }
+
+        event.text?.forEach { addCandidate(it, prioritized = sourcePrioritized) }
+        addCandidate(event.contentDescription, prioritized = sourcePrioritized)
+
+        val candidates = priorityCandidates + fallbackCandidates
