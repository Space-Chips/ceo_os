+_HistoryBadgeStyle _historyBadgeStyle(String? raw) {
+  switch ((raw ?? '').toLowerCase()) {
+    case 'crucial':
+    case 'critical':
+      return const _HistoryBadgeStyle(
+        background: Color(0x1FFF3C3C),
+        border: Color(0x59FF3C3C),
+        text: Color(0xFFFF6B6B),
+      );
+    case 'low':
+      return const _HistoryBadgeStyle(
+        background: Color(0x1F508CFF),
+        border: Color(0x59508CFF),
+        text: Color(0xFF6FA3FF),
+      );
+    case 'average':
+    case 'medium':
+      return const _HistoryBadgeStyle(
+        background: Color(0x1F787878),
+        border: Color(0x59787878),
+        text: Color(0xFFB8B8B8),
+      );
+    default:
+      return const _HistoryBadgeStyle(
+        background: Color(0x1F787878),
+        border: Color(0x59787878),
