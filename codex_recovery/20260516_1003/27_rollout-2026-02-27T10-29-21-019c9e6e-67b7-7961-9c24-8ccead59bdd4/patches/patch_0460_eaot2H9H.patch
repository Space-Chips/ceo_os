+String _formatMinutes(int minutes) {
+  if (minutes >= 60) {
+    final hours = minutes ~/ 60;
+    final rest = minutes % 60;
+    if (rest == 0) return '${hours}h';
+    return '${hours}h ${rest}m';
+  }
+  return '${minutes}m';
+}
