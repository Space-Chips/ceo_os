+  void _setActiveTab(_TaskTab tab) {
+    if (tab == _activeTab) return;
+    final direction = tab.index > _activeTab.index ? -1 : 1;
+    setState(() {
+      _tabDirection = direction;
+      _activeTab = tab;
+    });
