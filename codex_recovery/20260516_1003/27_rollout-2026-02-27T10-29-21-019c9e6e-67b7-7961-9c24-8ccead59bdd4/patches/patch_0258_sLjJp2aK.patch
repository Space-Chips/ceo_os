+  bool _isScheduled(Habit habit, DateTime day) {
+    if (habit.isDaily) return true;
+    if (habit.specificDays == null || habit.specificDays!.isEmpty) return true;
+    return habit.specificDays!.contains(_habitWeekday(day));
+  }
