+class _BackdropCausticPainter extends CustomPainter {
+  final double alpha;
+
+  const _BackdropCausticPainter({required this.alpha});
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final soft = Paint()
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 1.0
+      ..color = AppColors.accentSecondary.withValues(alpha: alpha * 0.42);
+    final warm = Paint()
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 1.2
+      ..color = AppColors.primaryOrange.withValues(alpha: alpha * 0.35);
+
+    final centerA = Offset(size.width * 0.18, size.height * 0.22);
+    final centerB = Offset(size.width * 0.84, size.height * 0.72);
+    for (var i = 0; i < 6; i++) {
+      final rectA = Rect.fromCircle(center: centerA, radius: 180 + (i * 48));
+      final rectB = Rect.fromCircle(center: centerB, radius: 150 + (i * 56));
+      canvas.drawArc(rectA, -0.6, 1.35, false, i.isEven ? soft : warm);
+      canvas.drawArc(rectB, 2.35, 1.1, false, i.isEven ? warm : soft);
+    }
+  }
+
+  @override
+  bool shouldRepaint(covariant _BackdropCausticPainter oldDelegate) {
+    return oldDelegate.alpha != alpha;
+  }
+}
