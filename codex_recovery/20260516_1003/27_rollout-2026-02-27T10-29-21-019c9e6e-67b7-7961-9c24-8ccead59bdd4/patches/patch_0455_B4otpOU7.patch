+  DateTime? _parseLooseDate(dynamic raw) {
+    if (raw == null) return null;
+    final value = raw.toString().trim();
+    if (value.isEmpty) return null;
+    if (value.contains('T')) {
+      return DateTime.tryParse(value);
+    }
+    return DateTime.tryParse('${value}T00:00:00');
+  }
