+  double _inferRankProgress(Map<String, dynamic> snapshot) {
+    final rankPoints = (snapshot['total_rank_points'] as num?)?.toDouble();
+    if (rankPoints == null || rankPoints <= 0) return 0;
+    return (rankPoints % 100).clamp(0, 100).toDouble();
+  }
