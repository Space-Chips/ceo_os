+class _BackdropFilamentPainter extends CustomPainter {
+  final double lineAlpha;
+
+  const _BackdropFilamentPainter({required this.lineAlpha});
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final light = Paint()
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 0.8
+      ..color = AppColors.glassHighlightSoft.withValues(alpha: lineAlpha);
+    final dark = Paint()
+      ..style = PaintingStyle.stroke
+      ..strokeWidth = 0.7
+      ..color = AppColors.glassShadowSoft.withValues(alpha: lineAlpha * 0.8);
+
+    final lines = math.max(16, (size.height / 52).floor());
+    for (var i = 0; i < lines; i++) {
+      final y = (i * size.height / lines) + ((i % 2) * 2.0);
+      final p = Path()..moveTo(0, y);
+      final wave = 4.0 + (i % 5) * 1.2;
+      final step = size.width / 6;
+      for (var x = 0.0; x <= size.width + step; x += step) {
+        final dy = math.sin((x / size.width) * math.pi * 2 + (i * 0.8)) * wave;
+        p.lineTo(x, y + dy);
+      }
+      canvas.drawPath(p, i.isEven ? light : dark);
+    }
+  }
+
+  @override
+  bool shouldRepaint(covariant _BackdropFilamentPainter oldDelegate) {
+    return oldDelegate.lineAlpha != lineAlpha;
+  }
+}
