+    private fun handleLauncherTap(packageName: String) {
+        val decision = blockStateCache.decisionFor(packageName)
+        if (!decision.blocked) return
+        blockingOverlay.show()
+        val launched = blockingNavigator.showBlockedScreen(
+            context = this,
+            packageName = packageName,
+            reason = decision.reason,
+            reasonKey = decision.reasonKey,
+        )
+        if (!launched) {
+            blockingOverlay.hide()
+        }
+    }
