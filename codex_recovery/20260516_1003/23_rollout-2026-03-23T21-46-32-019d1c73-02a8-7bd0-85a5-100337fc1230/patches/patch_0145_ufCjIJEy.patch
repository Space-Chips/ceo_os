+    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
+        if (event == null) return
+        if (
+            event.eventType != AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED &&
+            event.eventType != AccessibilityEvent.TYPE_WINDOWS_CHANGED &&
+            event.eventType != AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED
+        ) return
+
+        val now = SystemClock.elapsedRealtime()
+        val eventPackage = event.packageName?.toString()?.trim()
+        val rootPackage = rootInActiveWindow?.packageName?.toString()?.trim()
+        val isLauncher = launcherPackageResolver.isLauncherPackage(eventPackage) ||
+            launcherPackageResolver.isLauncherPackage(rootPackage)
+
+        if (isLauncher) {
+            lastWasLauncher = true
+            handleLauncherOverlay(now)
+            return
+        }
+
+        if (lastWasLauncher) {
+            lastWasLauncher = false
+            launcherOverlayController.clear()
+        }
+
+        if (event.eventType == AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED) {
+            return
+        }
+
+        val startedAt = System.currentTimeMillis()
+        if (eventPackage != null) {
+            val lastPackage = lastForegroundPackage
+            val lastAt = lastEventAtMillis
+            if (
+                lastPackage == eventPackage &&
+                event.eventType != AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED &&
+                startedAt - lastAt < 220L
+            ) {
+                return
+            }
+            lastForegroundPackage = eventPackage
+            lastEventAtMillis = startedAt
+        }
+
+        val isBrowser = foregroundAppDetector.isBrowserPackage(eventPackage)
+        val snapshot = foregroundAppDetector.createSnapshot(
+            event,
+            if (isBrowser) rootInActiveWindow else null,
+        )
+
+        handleSnapshot(snapshot, startedAt)
+    }
