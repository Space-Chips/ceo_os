+
+class BrowserBlockingOverlay(
+    private val service: AccessibilityService,
+) {
+    private var overlayView: View? = null
+    private var currentDomain: String? = null
+
+    fun show(toolbarBounds: Rect?, domain: String, reason: String) {
+        val windowManager = service.getSystemService(AccessibilityService.WINDOW_SERVICE) as? WindowManager
+            ?: return
+        val height = service.resources.displayMetrics.heightPixels
+        val topInset = toolbarBounds?.bottom?.coerceAtLeast(dp(72)) ?: dp(120)
+        val overlayHeight = (height - topInset).coerceAtLeast(dp(140))
+
+        val view = overlayView ?: createOverlayView().also {
+            overlayView = it
+        }
+        if (view.parent == null) {
+            try {
+                windowManager.addView(view, buildParams(topInset, overlayHeight))
+            } catch (_: Exception) {
+                overlayView = null
+                return
+            }
+        } else {
+            try {
+                windowManager.updateViewLayout(view, buildParams(topInset, overlayHeight))
+            } catch (_: Exception) {
+            }
+        }
+
+        val label = view.findViewWithTag<TextView>("domain_label")
+        val subtitle = view.findViewWithTag<TextView>("domain_subtitle")
+        label?.text = domain
+        subtitle?.text = when (reason) {
+            "daily_limit" -> "Daily limit reached for this site."
+            "scheduled_pause" -> "Blocked during your scheduled pause."
+            else -> "Blocked during your focus protections."
+        }
+        currentDomain = domain
+    }
+
+    fun hide() {
+        val windowManager = service.getSystemService(AccessibilityService.WINDOW_SERVICE) as? WindowManager
+            ?: return
+        val view = overlayView ?: return
+        try {
+            windowManager.removeViewImmediate(view)
+        } catch (_: Exception) {
+        } finally {
+            overlayView = null
+            currentDomain = null
+        }
+    }
+
+    fun isShowing(domain: String?): Boolean {
+        return overlayView != null && domain != null && domain == currentDomain
+    }
+
+    private fun createOverlayView(): View {
+        val root = FrameLayout(service).apply {
+            setBackgroundColor(Color.parseColor("#D0000000"))
+            isClickable = true
+            isFocusable = false
+        }
+
+        val card = LinearLayout(service).apply {
+            orientation = LinearLayout.VERTICAL
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.RECTANGLE
+                cornerRadius = dp(22).toFloat()
+                setColor(Color.parseColor("#F0171B22"))
+                setStroke(dp(1), Color.parseColor("#33F5F7FA"))
+            }
+            setPadding(dp(20), dp(18), dp(20), dp(18))
+            elevation = dp(16).toFloat()
+        }
+
+        val kicker = TextView(service).apply {
+            text = "BLOCKED WEBSITE"
+            setTextColor(Color.parseColor("#FFAA7C"))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 11f)
+            letterSpacing = 0.18f
+            typeface = Typeface.DEFAULT_BOLD
+        }
+
+        val domainLabel = TextView(service).apply {
+            tag = "domain_label"
+            setTextColor(Color.parseColor("#FFF5F7FA"))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 22f)
+            typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
+        }
+
+        val subtitle = TextView(service).apply {
+            tag = "domain_subtitle"
+            setTextColor(Color.parseColor("#C9D0D8E2"))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        }
+
+        val hint = TextView(service).apply {
+            text = "Change the website in the address bar to continue browsing."
+            setTextColor(Color.parseColor("#8BD7DCE5"))
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+        }
+
+        card.addView(kicker)
+        card.addView(spacer(8))
+        card.addView(domainLabel)
+        card.addView(spacer(8))
+        card.addView(subtitle)
+        card.addView(spacer(12))
+        card.addView(hint)
+
+        root.addView(
+            card,
+            FrameLayout.LayoutParams(
+                FrameLayout.LayoutParams.MATCH_PARENT,
+                FrameLayout.LayoutParams.WRAP_CONTENT,
+                Gravity.TOP or Gravity.CENTER_HORIZONTAL,
+            ).apply {
+                setMargins(dp(18), dp(18), dp(18), dp(18))
+            },
+        )
+        return root
+    }
+
+    private fun buildParams(y: Int, height: Int): WindowManager.LayoutParams {
+        return WindowManager.LayoutParams().apply {
+            type = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY
+            } else {
+                WindowManager.LayoutParams.TYPE_SYSTEM_ALERT
+            }
+            format = android.graphics.PixelFormat.TRANSLUCENT
+            gravity = Gravity.TOP or Gravity.START
+            this.y = y
+            x = 0
+            width = WindowManager.LayoutParams.MATCH_PARENT
+            this.height = height
+            flags =
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                    WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
+                    WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+                    WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
+        }
+    }
+
+    private fun dp(value: Int): Int {
