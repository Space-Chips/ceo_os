+class FlyToSlotOverlay {
+  static Future<void> flyItem({
+    required BuildContext context,
+    required Rect from,
+    required Rect to,
+    required ControlCenterItem item,
+  }) async {
+    final overlay = Overlay.of(context);
+    if (overlay == null) return;
+
+    final controller = AnimationController(
+      vsync: overlay,
+      duration: const Duration(milliseconds: 520),
+    );
+    final curved = CurvedAnimation(parent: controller, curve: Curves.easeOutCubic);
+
+    late final OverlayEntry entry;
+    entry = OverlayEntry(
+      builder: (context) {
+        final t = curved.value;
+        final left = lerpDouble(from.left, to.left, t)!;
+        final top = lerpDouble(from.top, to.top, t)!;
+        final width = lerpDouble(from.width, to.width, t)!;
+        final height = lerpDouble(from.height, to.height, t)!;
+        final opacity = (1.0 - (t * 0.2)).clamp(0.0, 1.0);
+        final scale = lerpDouble(1.0, 0.98, t)!;
+        return IgnorePointer(
+          child: Positioned(
+            left: left,
+            top: top,
+            width: width,
+            height: height,
+            child: Opacity(
+              opacity: opacity,
+              child: Transform.scale(
+                scale: scale,
+                child: _GhostCard(item: item),
+              ),
+            ),
+          ),
+        );
+      },
+    );
+
+    overlay.insert(entry);
+    controller.addListener(entry.markNeedsBuild);
+    controller.forward();
+    await controller.forward().orCancel.catchError((_) {});
+    entry.remove();
+    controller.dispose();
+  }
+}
+
