+Future<bool> _confirmDeletionTwice(
+  BuildContext context, {
+  required String firstTitle,
+  required String firstMessage,
+  required String secondTitle,
+  required String secondMessage,
+}) async {
+  final firstConfirmed = await showCupertinoDialog<bool>(
+    context: context,
+    builder: (dialogContext) => CupertinoAlertDialog(
+      title: Text(firstTitle),
+      content: Text(firstMessage),
+      actions: [
+        CupertinoDialogAction(
+          onPressed: () => Navigator.of(dialogContext).pop(false),
+          child: const Text('Cancel'),
+        ),
+        CupertinoDialogAction(
+          isDestructiveAction: true,
+          onPressed: () => Navigator.of(dialogContext).pop(true),
+          child: const Text('Delete'),
+        ),
+      ],
+    ),
+  );
+
+  if (firstConfirmed != true) return false;
+
+  final secondConfirmed = await showCupertinoDialog<bool>(
+    context: context,
+    builder: (dialogContext) => CupertinoAlertDialog(
+      title: Text(secondTitle),
+      content: Text(secondMessage),
+      actions: [
+        CupertinoDialogAction(
+          onPressed: () => Navigator.of(dialogContext).pop(false),
+          child: const Text('Back'),
+        ),
+        CupertinoDialogAction(
+          isDestructiveAction: true,
+          onPressed: () => Navigator.of(dialogContext).pop(true),
+          child: const Text('Confirm Delete'),
+        ),
+      ],
+    ),
+  );
+
+  return secondConfirmed == true;
+}
