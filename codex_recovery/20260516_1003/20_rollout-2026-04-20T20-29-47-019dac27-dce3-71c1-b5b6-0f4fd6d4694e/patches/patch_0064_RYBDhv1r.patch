+    private fun registerBrowserHomeRedirect(browserPackage: String?) {
+        val pkg = browserPackage?.trim().orEmpty()
+        if (pkg.isEmpty()) return
+        foregroundAppDetector.clearRecentDomain(pkg)
+        browserHomeGracePackage = pkg
+        browserHomeGraceUntilElapsed = SystemClock.elapsedRealtime() + 1_200L
+    }
+
+    private fun isBrowserHomeGraceActive(
+        browserPackage: String?,
+        nowElapsed: Long,
+    ): Boolean {
+        val pkg = browserPackage?.trim().orEmpty()
+        if (pkg.isEmpty()) return false
+        val gracePackage = browserHomeGracePackage ?: return false
+        if (gracePackage != pkg) return false
+        val active = nowElapsed <= browserHomeGraceUntilElapsed
+        if (!active) {
+            browserHomeGracePackage = null
+            browserHomeGraceUntilElapsed = 0L
+        }
+        return active
+    }
