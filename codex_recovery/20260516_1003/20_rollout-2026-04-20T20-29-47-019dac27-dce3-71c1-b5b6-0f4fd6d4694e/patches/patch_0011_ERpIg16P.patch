+    private fun resolveIconBounds(node: AccessibilityNodeInfo, initial: Rect): Rect {
+        if (isLikelyIconNode(node) && isValidIconBounds(initial)) {
+            return Rect(initial)
+        }
+
+        findBestIconBounds(node, maxDepth = 2)?.let { return it }
+        node.parent?.let { parent ->
+            findBestIconBounds(parent, maxDepth = 2)?.let { return it }
+        }
+
+        return shrinkCellBoundsToIcon(initial)
+    }
+
+    private fun findBestIconBounds(
+        start: AccessibilityNodeInfo,
+        maxDepth: Int,
+    ): Rect? {
+        val stack = ArrayDeque<Pair<AccessibilityNodeInfo, Int>>()
+        stack.add(start to 0)
+        val visited = mutableSetOf<Int>()
+        var bestBounds: Rect? = null
+        var bestScore = Int.MIN_VALUE
+        val bounds = Rect()
+
+        while (stack.isNotEmpty()) {
+            val (node, depth) = stack.removeFirst()
+            if (depth > maxDepth) continue
+            val identity = System.identityHashCode(node)
+            if (!visited.add(identity)) continue
+
+            if (isLikelyIconNode(node)) {
+                node.getBoundsInScreen(bounds)
+                if (isValidIconBounds(bounds)) {
+                    val score = iconNodeScore(bounds)
+                    if (score > bestScore) {
+                        bestScore = score
+                        bestBounds = Rect(bounds)
+                    }
+                }
+            }
+
+            for (index in 0 until node.childCount) {
+                node.getChild(index)?.let { child ->
+                    stack.add(child to depth + 1)
+                }
+            }
+        }
+
+        return bestBounds
+    }
+
+    private fun isLikelyIconNode(node: AccessibilityNodeInfo): Boolean {
+        val className = node.className?.toString()?.lowercase(Locale.getDefault()).orEmpty()
+        val viewId = node.viewIdResourceName?.lowercase(Locale.getDefault()).orEmpty()
+        if (className.contains("imageview")) return true
+        if (viewId.contains("icon")) return true
+        if (viewId.contains("app_icon")) return true
+        if (viewId.contains("iv_icon")) return true
+        return false
+    }
+
+    private fun isValidIconBounds(bounds: Rect): Boolean {
+        if (bounds.isEmpty) return false
+        val width = bounds.width()
+        val height = bounds.height()
+        if (width < minIconSizePx || height < minIconSizePx) return false
+        if (width > maxIconSizePx || height > maxIconSizePx) return false
+        val ratioDiff = abs(width - height)
+        return ratioDiff <= (max(width, height) * 0.35f).toInt()
+    }
+
+    private fun shrinkCellBoundsToIcon(cellBounds: Rect): Rect {
+        val size = min(
+            min(cellBounds.width(), cellBounds.height()),
+            (expectedIconSizePx * 1.2f).toInt(),
+        ).coerceIn(minIconSizePx, maxIconSizePx)
+        val left = cellBounds.left + ((cellBounds.width() - size) / 2)
+        val verticalOffset = ((cellBounds.height() - size) * 0.10f).toInt()
+        val top = (cellBounds.top + verticalOffset).coerceAtLeast(cellBounds.top)
+        return Rect(left, top, left + size, top + size)
+    }
+
+    private fun iconNodeScore(bounds: Rect): Int {
+        val width = bounds.width()
+        val height = bounds.height()
+        val squarePenalty = abs(width - height) * 3
+        val sizePenalty = abs(max(width, height) - expectedIconSizePx)
+        return 1000 - squarePenalty - sizePenalty
+    }
+
+    private fun scoreCandidate(
+        node: AccessibilityNodeInfo,
+        nodeBounds: Rect,
+        resolvedBounds: Rect,
+    ): Int {
+        var score = iconNodeScore(resolvedBounds)
+        if (isLikelyIconNode(node)) score += 140
+
+        if (nodeBounds.width() > resolvedBounds.width() || nodeBounds.height() > resolvedBounds.height()) {
+            score += 60
+        }
+
+        val centerYDelta = abs(nodeBounds.centerY() - resolvedBounds.centerY())
+        score -= centerYDelta / 4
+        return score
+    }
