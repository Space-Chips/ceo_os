+import '../utils/app_logger.dart';
+
+class BillingDiagnosticsService {
+  static final BillingDiagnosticsService _instance =
+      BillingDiagnosticsService._internal();
+
+  factory BillingDiagnosticsService() => _instance;
+
+  BillingDiagnosticsService._internal();
+
+  static const String _storageKey = 'billing_diagnostics_v1';
+  static const int _maxEntries = 120;
+
+  String? get _currentUserId => Supabase.instance.client.auth.currentUser?.id;
+
+  Future<void> log(
+    String event, {
+    Map<String, Object?> data = const {},
+  }) async {
+    final now = DateTime.now();
+    final uid = _currentUserId;
+    final entry = <String, Object?>{
+      'ts': now.toIso8601String(),
+      'event': event,
+      'platform': Platform.operatingSystem,
+      'uid': uid == null ? null : _redact(uid),
+      'data': data,
+    };
+
+    // Debug console (dev-only).
+    AppLogger.info('[billing] $event ${jsonEncode(entry)}');
+
+    // Persist locally (prod-safe).
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      final raw = prefs.getStringList(_storageKey) ?? <String>[];
+      raw.add(jsonEncode(entry));
+      final trimmed =
+          raw.length <= _maxEntries ? raw : raw.sublist(raw.length - _maxEntries);
+      await prefs.setStringList(_storageKey, trimmed);
+    } catch (_) {
+      // Best effort only.
+    }
+  }
+
+  Future<List<Map<String, Object?>>> getRecent() async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      final raw = prefs.getStringList(_storageKey) ?? <String>[];
+      return raw
+          .map((line) => jsonDecode(line))
+          .whereType<Map>()
+          .map((m) => Map<String, Object?>.from(m as Map))
+          .toList(growable: false);
+    } catch (_) {
+      return const [];
+    }
+  }
+
+  Future<String> exportText({int limit = 80}) async {
+    final entries = await getRecent();
+    final sliced = entries.length <= limit
+        ? entries
+        : entries.sublist(entries.length - limit);
+    return sliced.map((e) => jsonEncode(e)).join('\n');
+  }
+
+  Future<void> clear() async {
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      await prefs.remove(_storageKey);
+    } catch (_) {
+      // Best effort only.
+    }
+  }
+
+  String _redact(String uid) {
+    if (uid.length <= 10) return uid;
+    return '${uid.substring(0, 4)}…${uid.substring(uid.length - 4)}';
+  }
+}
