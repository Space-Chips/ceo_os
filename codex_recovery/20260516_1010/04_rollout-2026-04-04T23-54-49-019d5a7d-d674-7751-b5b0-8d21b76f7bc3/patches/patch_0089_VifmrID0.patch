+        val entry = lastEntry
+        return mapOf(
+            "eventType" to entry?.eventType,
+            "packageName" to entry?.packageName,
+            "className" to entry?.className,
+            "detectedUrl" to entry?.detectedUrl,
+            "decision" to entry?.decision,
