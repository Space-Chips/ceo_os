+package com.wakeapp.ceoos
+
+import android.accessibilityservice.AccessibilityService
+import android.os.SystemClock
+import java.util.Locale
+
+class BrowserBlockCoordinator {
+    private var lastBackSignature: String? = null
+    private var lastBackAtMillis: Long = 0L
+
+    fun evaluate(
+        snapshot: ForegroundSnapshot,
+        state: BlockPolicyState,
+    ): BlockDecision {
+        if (!snapshot.isBrowser) return BlockDecision.Allow
+        val browserPackage = snapshot.packageName?.trim().orEmpty()
+        if (browserPackage.isEmpty()) return BlockDecision.IgnoreTransient
+        val domain = snapshot.detectedBrowserUrl ?: return BlockDecision.IgnoreTransient
+        val blockedDomain = matchingConfiguredDomain(domain, state.blockedDomains) ?: return BlockDecision.Allow
+        val reason = when {
+            state.exceededDomains.contains(blockedDomain) -> "daily_limit"
+            state.classicPauseEnabled && state.classicPauseBlockedDomains.contains(blockedDomain) -> "scheduled_pause"
+            else -> "blocked_website"
+        }
+        return BlockDecision.BlockUrl(
+            browserPackage = browserPackage,
+            target = blockedDomain,
+            reason = reason,
+        )
+    }
+
+    fun handleBlockedUrl(
+        service: AccessibilityService,
+        decision: BlockDecision.BlockUrl,
+        gateLauncher: GateLauncher,
+    ): Boolean {
+        val signature = "${decision.browserPackage}|${decision.target}|${decision.reason}"
+        val now = SystemClock.elapsedRealtime()
+        val canTryBack = signature != lastBackSignature || now - lastBackAtMillis > 1500L
+        if (canTryBack && service.performGlobalAction(AccessibilityService.GLOBAL_ACTION_BACK)) {
+            lastBackSignature = signature
+            lastBackAtMillis = now
+            return false
+        }
+        return gateLauncher.launch(service, decision)
+    }
+
+    companion object {
+        fun normalizeDomainToken(raw: String?): String? {
+            val value = raw?.trim()?.lowercase(Locale.US).orEmpty()
+            if (value.isEmpty() || value == "__adult_content__") return null
+
+            var normalized = value
+                .replaceFirst(Regex("^https?://"), "")
+                .replaceFirst(Regex("^www\\d*\\."), "")
+
+            if (normalized.contains("@")) {
+                normalized = normalized.substringAfterLast('@')
+            }
+
+            normalized = normalized.substringBefore('/')
+                .substringBefore('?')
+                .substringBefore('#')
+                .substringBefore(':')
+                .trim('.')
+
+            return if (normalized.isNotEmpty() && normalized.contains('.') && !normalized.contains(' ')) {
+                normalized
+            } else {
+                null
+            }
+        }
+
+        private fun matchingConfiguredDomain(
+            currentDomain: String,
+            candidates: Set<String>,
+        ): String? {
+            return candidates
+                .filter { currentDomain == it || currentDomain.endsWith(".$it") }
+                .maxByOrNull { it.length }
+        }
+    }
