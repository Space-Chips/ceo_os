+        val sourcePrioritized = prioritizedViewIdHints.any { sourceViewId.contains(it) }
+        add(source?.text, prioritizedCandidate = sourcePrioritized)
+        add(source?.contentDescription, prioritizedCandidate = sourcePrioritized)
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            add(source?.hintText, prioritizedCandidate = sourcePrioritized)
+        }
+
