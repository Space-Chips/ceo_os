     private func webDomainTokens(from domains: [String]) -> Set<WebDomainToken> {
         var tokens = Set<WebDomainToken>()
         for domain in normalizedDomains(domains) {
             if let token = WebDomain(domain: domain).token {
                 tokens.insert(token)
             }
         }
         return tokens
     }
