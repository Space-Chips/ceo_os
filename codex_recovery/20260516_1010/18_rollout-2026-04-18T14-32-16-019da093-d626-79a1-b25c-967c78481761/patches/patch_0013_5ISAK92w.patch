+  Widget _mockIcon(
+    _MockIconData item, {
+    required double iconSize,
+    required double jiggleAmp,
+    required double time,
+    required bool hidden,
+  }) {
+    final origin = _iconOrigin(item.col, item.row);
+    final wave = math.sin((time * 2 * math.pi * 2) + (item.col + item.row));
+    return Positioned(
+      left: origin.dx * 1,
+      top: origin.dy * 1,
+      child: Opacity(
+        opacity: hidden ? 0 : 1,
+        child: Transform.rotate(
+          angle: jiggleAmp * wave,
+          child: _iconTile(
+            size: iconSize,
+            icon: item.icon,
+            accent: _iconAccent(item),
+            isEssential: item.row == 0,
+          ),
+        ),
+      ),
+    );
+  }
+
+  Color _iconAccent(_MockIconData item) {
+    if (item.row == 0) return AppColors.success.withValues(alpha: 0.85);
+    if (item.row == 1) return AppColors.info.withValues(alpha: 0.82);
+    if (item.row == 2) return AppColors.warning.withValues(alpha: 0.8);
+    return AppColors.secondaryLabel.withValues(alpha: 0.7);
+  }
+
+  Offset _iconOrigin(int col, int row) {
+    final startX = 0.04;
+    final startY = 0.14;
+    const spacingX = 0.285;
+    const spacingY = 0.17;
+    return Offset(startX + spacingX * col, startY + spacingY * row);
+  }
+}
