+class _LegacyPressScale extends StatefulWidget {
+  final Widget child;
+  final VoidCallback? onTap;
+  final double scaleWhenPressed;
+
+  const _LegacyPressScale({
+    required this.child,
+    required this.onTap,
+    this.scaleWhenPressed = 1.01,
+  });
+
+  @override
+  State<_LegacyPressScale> createState() => _LegacyPressScaleState();
+}
+
+class _LegacyPressScaleState extends State<_LegacyPressScale> {
+  bool _pressed = false;
+
+  void _setPressed(bool value) {
+    if (!mounted || _pressed == value) return;
+    setState(() => _pressed = value);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Listener(
+      onPointerDown: (_) => _setPressed(true),
+      onPointerUp: (_) => _setPressed(false),
+      onPointerCancel: (_) => _setPressed(false),
+      child: AnimatedScale(
+        scale: _pressed ? widget.scaleWhenPressed : 1,
+        duration: const Duration(milliseconds: 120),
+        curve: Curves.easeOutCubic,
+        child: GestureDetector(
+          behavior: HitTestBehavior.translucent,
+          onTap: widget.onTap,
+          child: widget.child,
+        ),
+      ),
+    );
+  }
+}
