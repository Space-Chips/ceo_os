+        _loading = false;
+      });
+      return;
+    }
+
+    final types = await _repo.getEventTypes();
+    if (!mounted) return;
+    setState(() {
+      _premiumBlock = null;
+      _types = types;
+      _loading = false;
+    });
+  }
