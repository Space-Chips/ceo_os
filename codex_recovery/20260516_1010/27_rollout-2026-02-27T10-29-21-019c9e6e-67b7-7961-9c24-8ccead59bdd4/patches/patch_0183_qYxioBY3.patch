+import 'package:flutter/cupertino.dart';
+import 'package:provider/provider.dart';
+
+import '../core/models/premium_models.dart';
+import '../core/providers/language_provider.dart';
+
+Future<void> showPremiumGateDialog(
+  BuildContext context,
+  PremiumCheckResult result,
+) async {
+  if (result.allowed) return;
+
+  final languageCode = context.read<LanguageProvider>().languageCode;
+  final message = premiumMessageForReason(
+    result.reason,
+    languageCode: languageCode,
+  );
+  final limit = result.limit;
+  final current = result.current;
+  final detailSuffix = (limit != null && current != null)
+      ? '\n\n$current / $limit'
+      : '';
+
+  await showCupertinoDialog<void>(
+    context: context,
+    builder: (dialogContext) => CupertinoAlertDialog(
+      title: Text(message.title),
+      content: Text('${message.description}$detailSuffix'),
+      actions: [
+        CupertinoDialogAction(
+          isDefaultAction: true,
+          onPressed: () => Navigator.of(dialogContext).pop(),
+          child: Text(languageCode == 'fr' ? 'Compris' : 'Got it'),
+        ),
+      ],
+    ),
+  );
+}
