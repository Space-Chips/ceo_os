+class _AdaptiveTwoColumnGrid<T> extends StatelessWidget {
+  final List<T> items;
+  final double spacing;
+  final Widget Function(T item) fullWidthBuilder;
+  final Widget Function(T item) squareBuilder;
+
+  const _AdaptiveTwoColumnGrid({
+    required this.items,
+    required this.spacing,
+    required this.fullWidthBuilder,
+    required this.squareBuilder,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    if (items.isEmpty) {
+      return const SizedBox.shrink();
+    }
+    if (items.length == 1) {
+      return fullWidthBuilder(items.first);
+    }
+
+    final rows = <Widget>[];
+    int index = 0;
+    while (index < items.length) {
+      final remaining = items.length - index;
+      if (remaining == 1) {
+        rows.add(fullWidthBuilder(items[index]));
+        index += 1;
+      } else {
+        rows.add(
+          Row(
+            children: [
+              Expanded(child: squareBuilder(items[index])),
+              SizedBox(width: spacing),
+              Expanded(child: squareBuilder(items[index + 1])),
+            ],
+          ),
+        );
+        index += 2;
+      }
+    }
+
+    return Column(
+      children: [
+        for (int i = 0; i < rows.length; i++) ...[
+          rows[i],
+          if (i != rows.length - 1) SizedBox(height: spacing),
+        ],
+      ],
+    );
+  }
+}
