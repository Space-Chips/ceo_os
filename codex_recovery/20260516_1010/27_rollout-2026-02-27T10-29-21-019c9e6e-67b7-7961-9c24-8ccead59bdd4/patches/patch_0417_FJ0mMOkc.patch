+  DateTime _roundToNextFive(DateTime dt) {
+    final floored = DateTime(dt.year, dt.month, dt.day, dt.hour, dt.minute);
+    final remainder = floored.minute % 5;
+    if (remainder == 0) return floored;
+    return floored.add(Duration(minutes: 5 - remainder));
+  }
