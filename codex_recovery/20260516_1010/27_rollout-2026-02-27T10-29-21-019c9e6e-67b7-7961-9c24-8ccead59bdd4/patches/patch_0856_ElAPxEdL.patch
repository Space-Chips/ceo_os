+-- Premium launch admin helpers.
+-- Run the statements you need in Supabase SQL editor.
+
+-- 1. Inspect current premium config
+select config_value
+from public.app_configs
+where config_key = 'premium';
+
+-- 2. End launch immediately and turn paywall on
+update public.app_configs
+set config_value = coalesce(config_value, '{}'::jsonb)
+  || jsonb_build_object(
+    'launch_mode_enabled', false,
+    'paywall_enabled', true
+  )
+where config_key = 'premium';
+
+-- 3. Extend launch by 7 days from now
+update public.app_configs
+set config_value = coalesce(config_value, '{}'::jsonb)
+  || jsonb_build_object(
+    'launch_mode_enabled', true,
+    'launch_ends_at', (now() + interval '7 days')
+  )
+where config_key = 'premium';
+
+-- 4. Set an exact launch end date
+-- Replace the timestamp before running.
+update public.app_configs
+set config_value = coalesce(config_value, '{}'::jsonb)
+  || jsonb_build_object(
+    'launch_ends_at', '2026-04-20T00:00:00+02:00'
+  )
+where config_key = 'premium';
+
+-- 5. Turn launch labels on/off
+update public.app_configs
+set config_value = coalesce(config_value, '{}'::jsonb)
+  || jsonb_build_object(
+    'launch_premium_labels_enabled', true
+  )
+where config_key = 'premium';
