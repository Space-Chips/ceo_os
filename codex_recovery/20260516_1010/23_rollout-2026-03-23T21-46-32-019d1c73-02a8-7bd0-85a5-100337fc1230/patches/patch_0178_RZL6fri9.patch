+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import '../../core/services/focus_service.dart';
+
+enum ScreenTimeSetupStep {
+  intro,
+  value,
+  overview,
+  permission,
+  success,
+}
+
+class ScreenTimeSetupController extends ChangeNotifier {
+  static const _prefSetupComplete = 'ios_screen_time_setup_complete';
+  static const _prefSetupHasRun = 'ios_screen_time_setup_has_run';
+  static const _prefSetupStep = 'ios_screen_time_setup_step';
+
+  final FocusService _focusService;
+  SharedPreferences? _prefs;
+  bool _initialized = false;
+  bool _isLoading = true;
+  bool _setupComplete = false;
+  bool _setupHasRun = false;
+  ScreenTimeSetupStep _currentStep = ScreenTimeSetupStep.intro;
+  FocusProtectionStatus _protectionStatus = FocusProtectionStatus.unknown;
+
+  ScreenTimeSetupController({FocusService? focusService})
+    : _focusService = focusService ?? FocusService();
+
+  bool get isLoading => _isLoading;
+  bool get isSetupComplete => _setupComplete;
+  bool get hasRunBefore => _setupHasRun;
+  ScreenTimeSetupStep get currentStep => _currentStep;
+  FocusProtectionStatus get protectionStatus => _protectionStatus;
+
+  bool get isAuthorized => _protectionStatus.isAuthorized;
+  bool get isSupported => _protectionStatus.isSupported;
+  bool get shouldPrompt => _protectionStatus.shouldPrompt;
+  bool get shouldOpenSettings => _protectionStatus.shouldOpenSettings;
+
+  bool get isSetupRequired =>
+      _isIos && isSupported && !_protectionStatus.isAuthorized;
+
+  bool get _isIos => !kIsWeb && Platform.isIOS;
+
+  Future<void> initialize() async {
+    if (_initialized) return;
+    _initialized = true;
+
+    if (!_isIos) {
+      _setupComplete = true;
+      _isLoading = false;
+      notifyListeners();
+      return;
+    }
+
+    _prefs = await SharedPreferences.getInstance();
+    _setupComplete = _prefs?.getBool(_prefSetupComplete) ?? false;
+    _setupHasRun = _prefs?.getBool(_prefSetupHasRun) ?? false;
+    _currentStep =
+        _stepFromName(_prefs?.getString(_prefSetupStep)) ??
+        ScreenTimeSetupStep.intro;
+
+    await refreshProtectionStatus();
+    _syncCompletionState();
+    _currentStep = _resolveInitialStep(_currentStep);
+    _isLoading = false;
+    notifyListeners();
+  }
+
+  Future<void> refreshProtectionStatus() async {
+    if (!_isIos) {
+      _protectionStatus = const FocusProtectionStatus(
+        permissionState: FocusPermissionState.approved,
+      );
+      return;
+    }
+    _protectionStatus = await _focusService.getProtectionStatus();
+  }
+
+  Future<void> markSetupComplete() async {
+    _setupComplete = true;
+    await _prefs?.setBool(_prefSetupComplete, true);
+    await _persistStep(ScreenTimeSetupStep.success);
+    notifyListeners();
+  }
+
+  Future<void> resetSetup() async {
+    _setupComplete = false;
+    _currentStep = ScreenTimeSetupStep.intro;
+    await _prefs?.setBool(_prefSetupComplete, false);
+    await _prefs?.setString(_prefSetupStep, _currentStep.name);
+    notifyListeners();
+  }
+
+  Future<void> advance() async {
+    await _markHasRun();
+    _currentStep = _nextStepAfter(_currentStep);
+    await _persistStep(_currentStep);
+    notifyListeners();
+  }
+
+  Future<void> jumpTo(ScreenTimeSetupStep step) async {
+    _currentStep = step;
+    await _persistStep(step);
+    notifyListeners();
+  }
+
+  Future<void> requestScreenTimeAccess() async {
+    await _focusService.requestPermissions();
+  }
+
+  Future<void> openSystemSettings() async {
+    await _focusService.openSystemSettings();
+  }
+
+  void _syncCompletionState() {
+    if (!isSupported) {
+      _setupComplete = true;
+      return;
+    }
+    if (isAuthorized) {
+      _setupComplete = true;
+    } else {
+      _setupComplete = false;
+    }
+  }
+
+  ScreenTimeSetupStep _resolveInitialStep(ScreenTimeSetupStep savedStep) {
+    if (_setupComplete) return ScreenTimeSetupStep.success;
+    if (!_setupHasRun) return ScreenTimeSetupStep.intro;
+    if (savedStep == ScreenTimeSetupStep.success && !_setupComplete) {
+      return ScreenTimeSetupStep.permission;
+    }
+    if (savedStep == ScreenTimeSetupStep.permission && isAuthorized) {
+      return ScreenTimeSetupStep.success;
+    }
+    return savedStep;
+  }
+
+  Future<void> _markHasRun() async {
+    if (_setupHasRun) return;
+    _setupHasRun = true;
+    await _prefs?.setBool(_prefSetupHasRun, true);
+  }
+
+  Future<void> _persistStep(ScreenTimeSetupStep step) async {
+    await _prefs?.setString(_prefSetupStep, step.name);
+  }
+
+  ScreenTimeSetupStep _nextStepAfter(ScreenTimeSetupStep step) {
+    final order = _orderedSteps;
+    final index = order.indexOf(step);
+    if (index == -1) return ScreenTimeSetupStep.intro;
+    if (index >= order.length - 1) return step;
+    return order[index + 1];
+  }
+
+  ScreenTimeSetupStep? _stepFromName(String? raw) {
+    if (raw == null || raw.isEmpty) return null;
+    for (final step in ScreenTimeSetupStep.values) {
+      if (step.name == raw) return step;
+    }
+    return null;
+  }
+
+  List<ScreenTimeSetupStep> get _orderedSteps => const [
+    ScreenTimeSetupStep.intro,
+    ScreenTimeSetupStep.value,
+    ScreenTimeSetupStep.overview,
+    ScreenTimeSetupStep.permission,
+    ScreenTimeSetupStep.success,
+  ];
+}
