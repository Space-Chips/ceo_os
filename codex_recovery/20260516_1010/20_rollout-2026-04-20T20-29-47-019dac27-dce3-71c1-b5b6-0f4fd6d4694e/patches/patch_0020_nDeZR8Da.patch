+package com.wakeapp.ceoos.blocking
+
+import android.accessibilityservice.AccessibilityService
+import android.graphics.PixelFormat
+import android.graphics.Rect
+import android.graphics.drawable.GradientDrawable
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.WindowManager
+import android.widget.FrameLayout
+
+class LauncherOverlayController(
+    private val service: AccessibilityService,
+    private val onBlockedIconTapped: (String) -> Unit,
+) {
+    private data class OverlayEntry(
+        val key: OverlayKey,
+        val view: View,
+    )
+
+    private val windowManager: WindowManager? =
+        service.getSystemService(AccessibilityService.WINDOW_SERVICE) as? WindowManager
+
+    private val overlays = mutableMapOf<OverlayKey, OverlayEntry>()
+
+    fun updateOverlays(
+        visibleTargets: List<LauncherIconTarget>,
+        blockedPackages: Set<String>,
+    ) {
+        val desired = visibleTargets
+            .filter { blockedPackages.contains(it.packageName) }
+            .associateBy(OverlayKey::from)
+
+        val iterator = overlays.entries.iterator()
+        while (iterator.hasNext()) {
+            val (key, entry) = iterator.next()
+            if (!desired.containsKey(key)) {
+                removeOverlay(entry.view)
+                iterator.remove()
+            }
+        }
+
+        desired.forEach { (key, target) ->
+            if (overlays.containsKey(key)) return@forEach
+            val view = createOverlayView(target.packageName)
+            addOverlay(view, target.bounds)
+            overlays[key] = OverlayEntry(key = key, view = view)
+        }
+    }
+
+    fun clear() {
+        overlays.values.forEach { removeOverlay(it.view) }
+        overlays.clear()
+    }
+
+    private fun createOverlayView(packageName: String): View {
+        val scrim = GradientDrawable().apply {
+            shape = GradientDrawable.RECTANGLE
+            cornerRadius = dp(14).toFloat()
+            setColor(0x8A44474Du.toInt())
+        }
+
+        return FrameLayout(service).apply {
+            background = scrim
+            isClickable = true
+            isFocusable = false
+            setOnTouchListener { _, event ->
+                if (event.action == MotionEvent.ACTION_UP) {
+                    onBlockedIconTapped(packageName)
+                }
+                true
+            }
+        }
+    }
+
+    private fun addOverlay(view: View, bounds: Rect) {
+        try {
+            windowManager?.addView(view, buildLayoutParams(bounds))
+        } catch (_: Exception) {
+        }
+    }
+
+    private fun removeOverlay(view: View) {
+        try {
+            windowManager?.removeViewImmediate(view)
+        } catch (_: Exception) {
+        }
+    }
+
+    private fun buildLayoutParams(bounds: Rect): WindowManager.LayoutParams {
+        return WindowManager.LayoutParams().apply {
+            type = WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY
+            format = PixelFormat.TRANSLUCENT
+            gravity = Gravity.TOP or Gravity.START
+            x = bounds.left
+            y = bounds.top
+            width = bounds.width()
+            height = bounds.height()
+            flags =
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                    WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
+                    WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+        }
+    }
+
+    private fun dp(value: Int): Int {
+        return TypedValue.applyDimension(
+            TypedValue.COMPLEX_UNIT_DIP,
+            value.toFloat(),
+            service.resources.displayMetrics,
+        ).toInt()
+    }
+}
