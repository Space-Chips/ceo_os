+    private fun isLikelyIconBounds(bounds: Rect): Boolean {
+        if (bounds.isEmpty) return false
+        val width = bounds.width()
+        val height = bounds.height()
+        if (width < dp(28) || height < dp(28)) return false
+        if (width > dp(96) || height > dp(96)) return false
+        return abs(width - height) <= (max(width, height) * 0.25f).toInt()
+    }
